void embaralhar_enigmas() {
    // 1. Cria a semente (seed) usando o ruído elétrico de um pino solto (ex: canal 2 / A2)
    // Se não fizer isso, o Arduino sempre vai sortear os mesmos números toda vez que ligar.
    randomSeed(meu_analogRead(2));

    // 2. Algoritmo Fisher-Yates (Padrão da indústria para embaralhar listas)
    // Percorre a lista de trás para frente trocando as posições aleatoriamente
    for (int i = total_enigmas - 1; i > 0; i--) {
        int j = random(0, i + 1); // Sorteia uma posição de 0 até i

        // Troca os valores de lugar
        uint8_t temporario = chaves_ativas[i];
        chaves_ativas[i] = chaves_ativas[j];
        chaves_ativas[j] = temporario;
    }
}

void jogo_enigmas(uint16_t valor_pot) {
    uint8_t numero = (valor_pot * 102L) / 1024;

    lcd.setCursor(0, 3);
    lcd.print(F("Resposta: "));

    if (numero < 10) {
        lcd.print('0');
    }
    lcd.print(numero);
    lcd.print(F("       "));

    if (flag_botao_apertado == 1) {
        lcd.setCursor(0, 2);

        if (numero == resposta_esperada) {
            lcd.print(F("CORRETO             "));
            lcd.setCursor(0, 3);
            enigma_n++;

            if (enigma_n <= limite_enig) {
                lcd.print(F("Proximo enigma"));
                delay(1000);
                lcd.clear();
                resposta_esperada = chaves_ativas[enigma_n - 1];
                Serial.println((const __FlashStringHelper*)pgm_read_word(&dicionario_enigmas[resposta_esperada]));
                Serial.print(F("\n"));
            }
        } else {
            erro_enigma += 1;
            lcd.print(F("ERRADO              "));
            lcd.setCursor(0, 3);
            lcd.print(F("Tente novamente"));
            lcd.setCursor(0, 1);
            lcd.print(F("-15s       erro: "));
            lcd.print(erro_enigma);
            lcd.print(F("/3"));
            tempo_restante -= 15;
            delay(1000);

            if (erro_enigma == 3) {
                lcd.clear();
                vidas_totais -= 1;
                tempo_restante -= 2;
                lcd.setCursor(0, 0);
                lcd.print(vidas_totais);
                lcd.print(F("/3 Vidas restantes "));
                erro_enigma = 0;
                delay(2000);
            }
            lcd.clear();
        }

        flag_botao_apertado = 0;
    }
}

