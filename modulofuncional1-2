void setup() {
    MCUSR = 0;
    wdt_disable(); // garante que o watchdog nao fique preso apos o reset

    Serial.begin(9600);
    for (uint8_t i = 0; i < 40; i++) {
        Serial.println();
    }

    // ADC: liga e ajusta prescaler 128
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);

    // pino 2 (botao INT0): entrada com pull-up interno
    clr_bit(DDRD, PD2);
    set_bit(PORTD, PD2);

    // pinos A0 (potenciometro), A1 (resistor) e A2 (ruido): entrada sem pull-up
    clr_bit(DDRC, PC0);
    clr_bit(PORTC, PC0);
    clr_bit(DDRC, PC1);
    clr_bit(PORTC, PC1);
    clr_bit(DDRC, PC2);
    clr_bit(PORTC, PC2);

    // desliga buffer digital nos canais analógicos usados
    set_bit(DIDR0, ADC0D);
    set_bit(DIDR0, ADC1D);
    set_bit(DIDR0, ADC2D);

    lcd.init();
    lcd.backlight();

    inicio_jogo();

    cli();
    clr_bit(EICRA, ISC00);
    set_bit(EICRA, ISC01);
    EIFR = (1 << INTF0);   // limpa qualquer flag pendente antes de habilitar INT0
    set_bit(EIMSK, INT0);

    // timer2 em modo CTC (1 ms)
    TCCR2A = (1 << WGM21);
    TCCR2B = 0;
    TCNT2  = 0;
    OCR2A  = 249;
    TIMSK2 = (1 << OCIE2A);
    TCCR2B = (1 << CS22);
    sei();
}

void loop() {
    tempo_display();

    if (estado_atual == 0) {
        if (printar_modulo != 0) {
            Serial.println(F("\n=== FASE 1: DIVISOR DE TENSAO ==="));
            Serial.println(F("Coloque o resistor e verifique no display sua resposta"));
            lcd.setCursor(0, 2);
            lcd.print(F("Fase 1: Resistor    "));
            delay(1000);
            lcd.setCursor(0, 2);
            lcd.print(F("Aguardando          "));
            lcd.setCursor(0, 3);
            lcd.print(F("resistor            "));
            printar_modulo = 0;
        }

        jogo_resistor(meu_analogRead(1));

        if (resistor_correto) {
            estado_atual++;
            Serial.println(F("\nParabéns, passou para a próxima fase!"));
            delay(1000);
            flag_botao_apertado = 0;
        }
    } else if (estado_atual == 1) {
        if (printar_modulo != 1) {
            Serial.println(F("\n=== FASE 2: ENIGMAS ==="));
            Serial.println(F("Gire o potenciômetro até o valor que corresponde ao enigma\n"));
            lcd.clear();
            lcd.setCursor(0, 2);
            lcd.print(F("Iniciando fase 2    "));
            delay(1000);
            lcd.clear();

            embaralhar_enigmas();
            resposta_esperada = chaves_ativas[0];
            Serial.println((const __FlashStringHelper*)pgm_read_word(&dicionario_enigmas[resposta_esperada]));
            Serial.println();
            printar_modulo = 1;
        }

        jogo_enigmas(meu_analogRead(0));

        if (enigma_n > limite_enig) {
            TCCR2B = 0; // Desliga o Timer2
            desenhar_defuse();
            estado_atual = 255;
            delay(5000);
        }
    }

    if (estado_atual == 255) {
        reset_jogo();
    }
}
