uint8_t erro_enigma       = 0;

ISR(INT0_vect) { // interrupcao para o botao de confirmacao
    static uint32_t ultimo_aperto_ms = 0;

    if (tempo_ms - ultimo_aperto_ms >= 150) { // debounce de 150 ms
        flag_botao_apertado = 1;
        ultimo_aperto_ms = tempo_ms;
    }
}

ISR(TIMER2_COMPA_vect) { // roda a cada 1 ms exato, timer para o tempo do jogo
    static uint16_t contador_ms = 0;

    tempo_ms++;
    contador_ms++;

    if (contador_ms >= 1000) {
        contador_ms -= 1000;
        flag_1s = 1;
    }
}

uint16_t meu_analogRead(uint8_t canal) {
    ADMUX = (1 << REFS0) | canal;  // referência 5 V + canal
    set_bit(ADCSRA, ADSC);         // começa a conversão
    while (tst_bit(ADCSRA, ADSC)); // espera terminar
    return ADC;                    // resultado: 0 a 1023
}

void inicio_jogo() { // para iniciar o jogo
    Serial.println(F("Digite '&' armar a bomba:"));
    lcd.print(F("Digite & para jogar:"));

    while (1) {
        if (Serial.available() > 0) {
            char tecla = Serial.read();
            if (tecla == '&') {
                break;
            }
        }
    }
}

void reset_jogo() { // resetar o jogo
    Serial.println(F("Digite 'r' para resetar:"));

    while (1) {
        if (Serial.available() > 0) {
            char tecla = Serial.read();
            if (tecla == 'r' || tecla == 'R') {
                wdt_enable(WDTO_15MS);
                while (1);
            }
        }
    }
}

void tempo_display() { // timer do tempo total do jogo
    if (tempo_restante > 0) {
        if (flag_1s) {
            tempo_restante -= 1;

            uint8_t minutos  = tempo_restante / 60;
            uint8_t segundos = tempo_restante % 60;

            lcd.setCursor(0, 0);
            lcd.print(F("Tempo restante: "));
            lcd.print(minutos);
            lcd.print(':');
            if (segundos < 10) {
                lcd.print('0');
            }
            lcd.print(segundos);
            flag_1s = 0;
        }
    }

    if (tempo_restante <= 0 || vidas_totais == 0) {
        TCCR2B = 0; // Desliga o Timer2
        desenhar_explosao();
        delay(5000);
        estado_atual = 255;
    }
}

//              ============== MODULO RESISTOR ==============
void jogo_resistor(uint16_t valor) {
    if (flag_botao_apertado == 1) {
        if (valor > LIMITE_INFERIOR && valor < LIMITE_SUPERIOR) {
            resistor_correto = 1;
            lcd.clear();
            lcd.setCursor(0, 2);
            lcd.print(F("PARABENS            "));
            lcd.setCursor(0, 3);
            lcd.print(F("resistor correto    "));
        } else {
            lcd.clear();
            lcd.setCursor(0, 1);
            lcd.print(F("-10s                "));
            lcd.setCursor(0, 2);
            lcd.print(F("ERRO                "));
            lcd.setCursor(0, 3);
            lcd.print(F("resistor errado     "));
            tempo_restante -= 10;
        }
        flag_botao_apertado = 0;
    }
}

