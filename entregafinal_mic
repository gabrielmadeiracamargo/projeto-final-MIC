void mostrar_conta() {
    lcd.setCursor(0, 1);
    lcd.print(F("                    "));

    lcd.setCursor(0, 2);
    lcd.print(F("Conta "));
    lcd.print(conta_n);
    lcd.print('/');
    lcd.print(limite_contas);
    lcd.print(F("           "));

    lcd.setCursor(0, 3);
    lcd.print(numero_a);
    lcd.print(F(" + "));
    lcd.print(numero_b);
    lcd.print(F(" = ?         "));
}

void gerar_conta() {
    numero_a        = random(0, 100);
    numero_b        = random(0, 100);
    resultado_conta = numero_a + numero_b;

    mostrar_conta();

    Serial.println();
    Serial.print(F("Conta "));
    Serial.print(conta_n);
    Serial.print('/');
    Serial.println(limite_contas);

    Serial.print(numero_a);
    Serial.print(F(" + "));
    Serial.print(numero_b);
    Serial.println(F(" = ?"));
}

void checar_conta() {
    if (resposta_jogador == resultado_conta) {
        Serial.println(F("Correto!"));

        lcd.setCursor(0, 2);
        lcd.print(F("CORRETO             "));

        conta_n++;

        if (conta_n <= limite_contas) {
            lcd.setCursor(0, 3);
            lcd.print(F("Proxima conta       "));
            delay(1000);
            gerar_conta();
        }
    } else {
        Serial.println(F("Incorreto! -15 segundos"));

        erros += 1;
        lcd.setCursor(0, 1);
        lcd.print(F("-15s       erro: "));
        lcd.print(erros);
        lcd.print(F("/3"));
        lcd.setCursor(0, 2);
        lcd.print(F("ERRADO              "));
        lcd.setCursor(0, 3);
        lcd.print(F("Tente novamente     "));
        tempo_restante -= 15;
        delay(1000);

        if (erros == 3) {
            lcd.clear();
            vidas_totais -= 1;
            tempo_restante -= 2;
            lcd.setCursor(0, 0);
            lcd.print(vidas_totais);
            lcd.print(F("/3 Vidas restantes "));
            erros = 0;
            delay(2000);
        }    

        if (tempo_restante > 0) {
            mostrar_conta();
        }
    }
}

void jogo_matematica() {
    while (Serial.available() > 0) {
        char entrada = Serial.read();

        if (entrada >= '0' && entrada <= '9') {
            if (resposta_jogador < 1000) {
                resposta_jogador = (resposta_jogador * 10) + (entrada - '0');
                digitando = 1;
            }
        } else if (entrada == '\n' || entrada == '\r') {
            if (digitando == 1) {
                Serial.print(F("Resposta: "));
                Serial.println(resposta_jogador);

                checar_conta();

                resposta_jogador = 0;
                digitando        = 0;
                break;
            }
        }
    }
}

