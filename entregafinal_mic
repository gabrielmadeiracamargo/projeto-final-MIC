void setup() {
    MCUSR = 0;
    wdt_disable(); // garante que o watchdog nao fique preso apos o reset

    Serial.begin(9600);
    for (uint8_t i = 0; i < 40; i++) {
        Serial.println();
    }

    // ADC: liga e ajusta prescaler 128
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);

    // pino 9 (PB1 / OC1A - buzzer): saida em LOW com Timer1 desligado
    set_bit(DDRB, PB1);
    clr_bit(PORTB, PB1);
    TCCR1A = 0;
    TCCR1B = 0;

    // pinos 10 a 13 (PB2 a PB5 - fios): entrada com pull-up interno (sem mexer no PB1/pino 9)
    clr_bit(DDRB, PB2); set_bit(PORTB, PB2);
    clr_bit(DDRB, PB3); set_bit(PORTB, PB3);
    clr_bit(DDRB, PB4); set_bit(PORTB, PB4);
    clr_bit(DDRB, PB5); set_bit(PORTB, PB5);

    // pino 2 (botao INT0): entrada com pull-up interno
    clr_bit(DDRD, PD2);
    set_bit(PORTD, PD2);

    // pinos A0 (potenciometro), A1 (resistor) e A2 (ruido): entrada sem pull-up
    clr_bit(DDRC, PC0);
    clr_bit(PORTC, PC0);
    clr_bit(DDRC, PC1);
    clr_bit(PORTC, PC1);
    clr_bit(DDRC, PC2);
    clr_bit(PORTC, PC2);

    // desliga buffer digital nos canais analógicos usados
    set_bit(DIDR0, ADC0D);
    set_bit(DIDR0, ADC1D);
    set_bit(DIDR0, ADC2D);

    lcd.init();
    lcd.backlight();

    lcd.setCursor(0,2);
    lcd.print(F("Voce tem 3 vidas"));
    Serial.println(F("Digite '&' armar a bomba:"));
    lcd.setCursor(0,0);
    lcd.print(F("Digite & para jogar:"));

    cli();
    clr_bit(EICRA, ISC00);
    set_bit(EICRA, ISC01);
    EIFR = (1 << INTF0);   // limpa qualquer flag pendente antes de habilitar INT0
    set_bit(EIMSK, INT0);

    // timer2 em modo CTC (1 ms)
    TCCR2A = (1 << WGM21);
    TCCR2B = 0;
    TCNT2  = 0;
    OCR2A  = 249;
    TIMSK2 = (1 << OCIE2A);
    TCCR2B = (1 << CS22);
    sei();
}

void loop() {
    if (estado_atual == 251) return;
    saida_serial.atualizar(); // watchdog vai reiniciar
    if (estado_atual == 254) { inicio_jogo(); return; }
    if (estado_atual == 255) { reset_jogo(); return; }
    if (estado_atual == 253) { entrada_fora_da_hora(); desenhar_explosao(); return; }
    if (estado_atual == 252) {
        entrada_fora_da_hora();
        if (ler_tempo_ms() - inicio_espera >= 5000) {
            estado_atual = 255;
            saida_serial.println(F("Digite 'r' para resetar:"));
        }
        return;
    }

    tempo_display();
    verificar_derrota();
    if (estado_atual == 253) return;

    if (espera != SEM_ESPERA) {
        if (estado_atual == 1) leitura_filtrada(1);
        if (estado_atual == 2) leitura_filtrada(0);
        if (consumir_botao()) saida_serial.println(F("Aguarde a proxima tela."));
        entrada_fora_da_hora();
        atualizar_espera();
        return;
    }

    // ============== FASE 1: FIOS ==============
    if (estado_atual == 0) {
        if (printar_modulo != 0) {
            saida_serial.println(F("\n=== FASE 1: FIOS ==="));
            saida_serial.println(F("Retire o fio correto e aperte o botao para confirmar:\n"));
            sortear_fio();
            saida_serial.println();
            lcd.clear();
            ultimo_tempo_exibido = -1;
            lcd.setCursor(0, 2);
            lcd.print(F("Fase 1: Fios        "));
            printar_modulo = 0;
            aguardar(INTRO, 1000);
            return;
        }
        jogo_fios();
        if (fio_correto) {
            saida_serial.println(F("\nParabéns, passou para a próxima fase!"));
            aguardar(AVANCAR, 1000);
        }
    }
    // ============== FASE 2: RESISTOR ==============
    else if (estado_atual == 1) {
        if (printar_modulo != 1) {
            saida_serial.println(F("\n=== FASE 2: DIVISOR DE TENSAO ==="));
            saida_serial.println(F("Coloque o resistor e verifique no display sua resposta"));
            lcd.clear();
            ultimo_tempo_exibido = -1;
            lcd.setCursor(0, 2);
            lcd.print(F("Fase 2: Resistor    "));
            printar_modulo = 1;
            aguardar(INTRO, 1000);
            return;
        }
        jogo_resistor(leitura_filtrada(1));
        if (resistor_correto) {
            saida_serial.println(F("\nParabéns, passou para a próxima fase!"));
            aguardar(AVANCAR, 1000);
        }
    }
    // ============== FASE 3: ENIGMAS ==============
    else if (estado_atual == 2) {
        if (printar_modulo != 2) {
            saida_serial.println(F("\n=== FASE 3: ENIGMAS ==="));
            saida_serial.println(F("Gire o potenciômetro até o valor que corresponde ao enigma\n"));
            lcd.clear();
            ultimo_tempo_exibido = -1;
            lcd.setCursor(0, 2);
            lcd.print(F("Iniciando fase 3    "));
            printar_modulo = 2;
            aguardar(INTRO, 1000);
            return;
        }
        jogo_enigmas(leitura_filtrada(0));
        if (enigma_n > limite_enig) {
            saida_serial.println(F("\nParabéns, passou para a última fase!"));
            aguardar(AVANCAR, 1000);
        }
    }
    // ============== FASE 4: MATEMATICA ==============
    else if (estado_atual == 3) {
        if (printar_modulo != 3) {
            saida_serial.println(F("\n=== FASE 4: MATEMATICA ==="));
            saida_serial.println(F("Resolva as contas e digite o resultado no Monitor Serial\n"));
            lcd.clear();
            ultimo_tempo_exibido = -1;
            lcd.setCursor(0, 2);
            lcd.print(F("Iniciando fase 4    "));
            printar_modulo = 3;
            aguardar(INTRO, 1000);
            return;
        }
        jogo_matematica();
    }

    if (estado_atual < 3) entrada_fora_da_hora();
    else if (estado_atual == 3 && consumir_botao())
        saida_serial.println(F("Responda pelo Monitor Serial."));

    // Atualiza o tempo antes de decidir vitoria ou derrota.
    tempo_display();
    verificar_derrota();
    if (estado_atual == 3 && conta_n > limite_contas) {
        buzzer_desligar();
        desenhar_defuse();
        estado_atual = 252;
        inicio_espera = ler_tempo_ms();
    }
}
