void jogo_enigmas(uint16_t valor_pot) {
    uint8_t numero = (valor_pot * 103L) / 1024;
    if (numero > 99) numero = 99;

    // Mantem o mapeamento original (103/1024) e acrescenta margem de 2 ADC.
    if (!pot_iniciado) {
        numero_pot = numero;
        pot_iniciado = 1;
    } else if (numero > numero_pot) {
        uint16_t limite = (numero * 1024UL + 102) / 103;
        numero_pot = (valor_pot >= limite + 2) ? numero : numero - 1;
    } else if (numero < numero_pot) {
        uint16_t limite = ((numero + 1) * 1024UL + 102) / 103;
        numero_pot = (valor_pot + 2 < limite) ? numero : numero + 1;
    }
    numero = numero_pot;

    // Atualiza apenas quando muda, evitando reescrever o LCD continuamente.
    if (numero != ultimo_numero) {
        ultimo_numero = numero;
        lcd.setCursor(0, 3);
        lcd.print(F("Resposta: "));

        if (numero < 10) {
            lcd.print('0');
        }
        lcd.print(numero);
        lcd.print(F("       "));
    }

    if (consumir_botao()) {
        lcd.setCursor(0, 2);

        if (numero == resposta_esperada) {
            lcd.print(F("CORRETO             "));
            lcd.setCursor(0, 3);
            enigma_n++;

            if (enigma_n <= limite_enig) {
                lcd.print(F("Proximo enigma"));
                aguardar(ENIG_ACERTO, 1000);
            }
        } else {
            erros += 1;
            lcd.print(F("ERRADO              "));
            lcd.setCursor(0, 3);
            lcd.print(F("Tente novamente"));
            lcd.setCursor(0, 1);
            lcd.print(F("-10s       erro: "));
            lcd.print(erros);
            lcd.print(F("/3"));
            tempo_restante -= 10;
            if (erros == 3) {
                vidas_totais -= 1;
                tempo_restante -= 2;
            }
            aguardar(ENIG_ERRO, 1000);
        }
    }
}

