uint32_t ler_tempo_ms() {
    uint32_t copia;
    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) { copia = tempo_ms; }
    return copia;
}

uint8_t consumir_botao() {
    uint8_t apertou;
    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
        apertou = flag_botao_apertado;
        flag_botao_apertado = 0;
    }
    return apertou;
}

void aguardar(uint8_t proxima_acao, uint16_t duracao) {
    espera = proxima_acao;
    inicio_espera = ler_tempo_ms();
    duracao_espera = duracao;
}

ISR(INT0_vect) { // interrupcao para o botao de confirmacao
    static uint32_t ultimo_aperto_ms = 0;

    if (tempo_ms - ultimo_aperto_ms >= 150) { // debounce de 150 ms
        flag_botao_apertado = 1;
        ultimo_aperto_ms = tempo_ms;
    }
}

ISR(TIMER2_COMPA_vect) { // roda a cada 1 ms exato
    tempo_ms++;
}

uint16_t meu_analogRead(uint8_t canal) {
    ADMUX = (1 << REFS0) | canal;  // referência 5 V + canal
    set_bit(ADCSRA, ADSC);         // começa a conversão
    while (tst_bit(ADCSRA, ADSC)); // espera terminar
    return ADC;                    // resultado: 0 a 1023
}

// Filtragem dos canais A0 e A1, mantendo meu_analogRead original.
uint16_t leitura_filtrada(uint8_t canal) {
    static uint16_t filtro[2] = {0, 0}; // ponto fixo: valor ADC vezes 16
    static uint32_t ultima_amostra[2] = {0, 0};
    static uint8_t iniciado[2] = {0, 0};
    uint32_t agora = ler_tempo_ms();
    if (!iniciado[canal] || agora - ultima_amostra[canal] >= 10) {
        ultima_amostra[canal] = agora;
        uint16_t alvo = meu_analogRead(canal) * 16U;
        if (!iniciado[canal]) {
            filtro[canal] = alvo;
            iniciado[canal] = 1;
        } else {
            filtro[canal] += ((int16_t)alvo - (int16_t)filtro[canal]) / 4;
        }
    }
    return (filtro[canal] + 8U) / 16U;
}

//              ============== BUZZER (TIMER1 - PINO 9 / PB1) ==============
void buzzer_ligar(uint16_t freq) {
    TCCR1B = 0;
    TCCR1A = (1 << COM1A0);              // inverte o pino 9 (OC1A) por hardware
    TCNT1  = 0;
    OCR1A  = (1000000UL / freq) - 1;
    TCCR1B = (1 << WGM12) | (1 << CS11); // modo CTC + prescaler 8
}

void buzzer_desligar() {
    TCCR1A = 0;
    TCCR1B = 0;
    clr_bit(PORTB, PB1);
}

void inicio_jogo() { // chamado a cada loop, ate receber &
    if (Serial.available() > 0) {
        char tecla = Serial.read();
        if (tecla == '&') {
            marco_segundo = ler_tempo_ms();
            consumir_botao();
            estado_atual = 0;
        } else if (tecla != '\r' && tecla != '\n') {
            saida_serial.println(F("Entrada invalida. Digite &."));
        }
    }
}

void reset_jogo() { // chamado a cada loop, ate receber r
    if (Serial.available() > 0) {
        char tecla = Serial.read();
        if (tecla == 'r' || tecla == 'R') {
            estado_atual = 251;
            wdt_enable(WDTO_15MS);
        } else if (tecla != '\r' && tecla != '\n') {
            saida_serial.println(F("Entrada invalida. Digite r."));
        }
    }
}

void tempo_display() {
    uint32_t agora = ler_tempo_ms();
    uint32_t segundos_passados = (agora - marco_segundo) / 1000UL;
    if (segundos_passados > 0) {
        marco_segundo += segundos_passados * 1000UL;
        if (tempo_restante > 0) {
            if (segundos_passados >= (uint32_t)tempo_restante) tempo_restante = 0;
            else tempo_restante -= segundos_passados;
        }
        if (tempo_restante <= 10 && tempo_restante > 0) {
            buzzer_ligar(2000);
            inicio_buzzer = ler_tempo_ms();
            buzzer_ativo = 1;
        }
    }
    if (buzzer_ativo && ler_tempo_ms() - inicio_buzzer >= 100) {
        buzzer_desligar();
        buzzer_ativo = 0;
    }

    // Durante a mensagem de vidas, nao sobrescrever a primeira linha.
    if (tempo_restante != ultimo_tempo_exibido &&
        espera != FIO_VIDAS && espera != ENIG_VIDAS && espera != CONTA_VIDAS &&
        tempo_restante > 0) {
        uint8_t minutos  = tempo_restante / 60;
        uint8_t segundos = tempo_restante % 60;
        lcd.setCursor(0, 0);
        lcd.print(F("Tempo restante: "));
        lcd.print(minutos);
        lcd.print(':');
        if (segundos < 10) lcd.print('0');
        lcd.print(segundos);
        ultimo_tempo_exibido = tempo_restante;
    }
}

void verificar_derrota() {
    if (tempo_restante <= 0 || vidas_totais == 0) {
        espera = SEM_ESPERA;
        buzzer_ativo = 0;
        buzzer_ligar(500);
        etapa_explosao = 0;
        estado_atual = 253;
    }
}

