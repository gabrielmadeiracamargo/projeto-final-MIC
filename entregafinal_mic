void jogo_matematica() {
    // Le apenas um caractere por passagem, sem esperar pelo restante da linha.
    if (Serial.available() <= 0) return;
    char entrada = Serial.read();
    if (entrada == '\n' && ignorar_lf) { ignorar_lf = 0; return; }
    ignorar_lf = (entrada == '\r');
    if (entrada == '\n' || entrada == '\r') {
        if (!linha_fora_da_hora) {
            if (digitando == 0) entrada_invalida = 1;
            if (entrada_invalida) {
                saida_serial.println(F("Entrada invalida. Digite de 1 a 3 algarismos."));
            } else {
                saida_serial.print(F("Resposta: "));
                saida_serial.println(resposta_jogador);
            }
            checar_conta();
        }
        resposta_jogador = 0;
        digitando = 0;
        entrada_invalida = 0;
        linha_fora_da_hora = 0;
    } else if (!linha_fora_da_hora) {
        if (entrada >= '0' && entrada <= '9' && digitando < 3) {
            resposta_jogador = resposta_jogador * 10 + (entrada - '0');
            digitando++;
        } else {
            entrada_invalida = 1;
        }
    }
}

// Respostas enviadas durante a troca de telas nao viram respostas da proxima conta.
void entrada_fora_da_hora() {
    if (Serial.available() <= 0) return;
    char entrada = Serial.read();
    if (entrada == '\n' && ignorar_lf) { ignorar_lf = 0; return; }
    ignorar_lf = (entrada == '\r');
    if (!linha_fora_da_hora && (estado_atual == 3 || (entrada != '\r' && entrada != '\n')))
        saida_serial.println(F("Entrada fora de hora. Aguarde a proxima pergunta."));
    linha_fora_da_hora = (entrada != '\r' && entrada != '\n');
    resposta_jogador = 0;
    digitando = 0;
    entrada_invalida = 0;
}

void atualizar_espera() {
    if (espera == SEM_ESPERA || ler_tempo_ms() - inicio_espera < duracao_espera) return;
    uint8_t acao = espera;
    espera = SEM_ESPERA;
    if (acao == INTRO) {
        if (estado_atual == 0 || estado_atual == 1) {
            lcd.setCursor(0, 2);
            lcd.print(F("Aguardando          "));
            lcd.setCursor(0, 3);
            if (estado_atual == 0) lcd.print(F("fio                 "));
            else lcd.print(F("resistor            "));
        } else if (estado_atual == 2) {
            lcd.clear();
            embaralhar_enigmas();
            resposta_esperada = chaves_ativas[0];
            saida_serial.println((const __FlashStringHelper*)pgm_read_word(&dicionario_enigmas[resposta_esperada]));
            saida_serial.println();
            ultimo_numero = 255;
        } else if (estado_atual == 3) {
            lcd.clear();
            randomSeed(meu_analogRead(2));
            gerar_conta();
        }
    } else if (acao == AVANCAR) {
        estado_atual++;
    } else if (acao == FIO_ERRO) {
        lcd.setCursor(0, 0);
        lcd.print(vidas_totais);
        lcd.print(F("/3 Vidas restantes "));
        aguardar(FIO_VIDAS, 2000);
    } else if (acao == FIO_VIDAS) {
        lcd.clear();
        lcd.setCursor(0, 2);
        lcd.print(F("Tente novamente     "));
        lcd.setCursor(0, 3);
        lcd.print(F("Reconecte o fio     "));
    } else if (acao == RES_ERRO) {
        lcd.clear();
        lcd.setCursor(0, 2);
        lcd.print(F("Tente novamente     "));
    } else if (acao == ENIG_ACERTO) {
        lcd.clear();
        resposta_esperada = chaves_ativas[enigma_n - 1];
        saida_serial.println((const __FlashStringHelper*)pgm_read_word(&dicionario_enigmas[resposta_esperada]));
        saida_serial.println();
        ultimo_numero = 255;
    } else if (acao == ENIG_ERRO || acao == CONTA_ERRO) {
        if (erros == 3) {
            lcd.clear();
            lcd.setCursor(0, 0);
            lcd.print(vidas_totais);
            lcd.print(F("/3 Vidas restantes "));
            erros = 0;
            aguardar(acao == ENIG_ERRO ? ENIG_VIDAS : CONTA_VIDAS, 2000);
        } else if (acao == ENIG_ERRO) {
            lcd.clear();
            ultimo_numero = 255;
        } else mostrar_conta();
    } else if (acao == ENIG_VIDAS) {
        lcd.clear();
        ultimo_numero = 255;
    } else if (acao == CONTA_VIDAS) {
        lcd.clear();
        mostrar_conta();
    } else if (acao == CONTA_ACERTO) {
        gerar_conta();
    }
    ultimo_tempo_exibido = -1;
}

