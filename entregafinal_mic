// Saida serial: preserva os textos e evita esperar o buffer da UART esvaziar.
// Cada item guarda apenas um ponteiro para a Flash ou um numero.
class SaidaSerial {
    struct Item {
        const char* texto;
        uint16_t numero;
        uint8_t tipo, base, quebra;
    };
    static const uint8_t TAM = 48;
    Item fila[TAM];
    uint8_t inicio = 0, fim = 0, total = 0, perdeu = 0;

    void inserir(const char* texto, uint16_t numero, uint8_t tipo,
                 uint8_t base, uint8_t quebra) {
        if (total == TAM) { perdeu = 1; return; }
        fila[fim] = {texto, numero, tipo, base, quebra};
        fim = (fim + 1) % TAM;
        total++;
    }
public:
    void print(const __FlashStringHelper* texto) { inserir((const char*)texto, 0, 0, 10, 0); }
    void println(const __FlashStringHelper* texto) { inserir((const char*)texto, 0, 0, 10, 1); }
    void print(uint16_t numero) { inserir(NULL, numero, 1, 10, 0); }
    void println(uint16_t numero, uint8_t base = 10) { inserir(NULL, numero, 1, base, 1); }
    void print(char c) { inserir(NULL, c, 2, 10, 0); }
    void print(uint8_t numero) { print((uint16_t)numero); }
    void print(int numero) { print((uint16_t)numero); }
    void println() { println(F("")); }
    void atualizar() {
        for (uint8_t i = 0; i < 16 && total && Serial.availableForWrite() > 0; i++) {
            Item &m = fila[inicio];
            if (m.tipo == 0) {
                char c = pgm_read_byte(m.texto);
                if (c) { Serial.write((uint8_t)c); m.texto++; continue; }
                m.tipo = 3;
            } else if (m.tipo == 1) {
                if (Serial.availableForWrite() < 16) return;
                Serial.print(m.numero, m.base);
                m.tipo = 3;
            } else if (m.tipo == 2) {
                Serial.write((uint8_t)m.numero);
                m.tipo = 3;
            }
            if (m.quebra) {
                if (Serial.availableForWrite() < 2) return;
                Serial.write('\r'); Serial.write('\n');
            }
            inicio = (inicio + 1) % TAM;
            total--;
        }
        if (perdeu && total < 16) {
            perdeu = 0;
            println(F("Aviso: fila serial cheia; houve perda de mensagens."));
        }
    }
} saida_serial;

