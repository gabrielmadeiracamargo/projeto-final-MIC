}

//              ============== MODULO RESISTOR ==============
void jogo_resistor(uint16_t valor) {
    // Histerese: entra na faixa com margem de 5; sai nos limites originais.
    if (resistor_na_faixa) {
        if (valor <= LIMITE_INFERIOR || valor >= LIMITE_SUPERIOR)
            resistor_na_faixa = 0;
    } else if (valor > LIMITE_INFERIOR + 5 && valor < LIMITE_SUPERIOR - 5) {
        resistor_na_faixa = 1;
    }
    if (consumir_botao()) {
        if (resistor_na_faixa) {
            resistor_correto = 1;
            lcd.clear();
            ultimo_tempo_exibido = -1;
            lcd.setCursor(0, 2);
            lcd.print(F("PARABENS            "));
            lcd.setCursor(0, 3);
            lcd.print(F("resistor correto    "));
        } else {
            lcd.clear();
            ultimo_tempo_exibido = -1;
            lcd.setCursor(0, 1);
            lcd.print(F("-10s                "));
            lcd.setCursor(0, 2);
            lcd.print(F("ERRO                "));
            lcd.setCursor(0, 3);
            lcd.print(F("resistor errado     "));
            tempo_restante -= 10;
            aguardar(RES_ERRO, 1000);
        }
    }
}

